# Copy to .env (gitignored) and fill in. Settings load via pydantic-settings —
# see src/asx_engine/config.py for which fields are required vs defaulted.

# --- GCP resources (required; no defaults — missing values fail at startup) ---
ASX_GCP_PROJECT=your-gcp-project-id
ASX_GCS_RAW_BUCKET=your-private-pdf-bucket
ASX_BQ_DATASET=asx_engine

# --- Anthropic (required for extraction, step 7+) ---
# console.anthropic.com -> API Keys. Read directly by the anthropic client
# library, never stored in Settings (so it can't leak via logging/repr).
ANTHROPIC_API_KEY=sk-ant-...

# --- Ingestion etiquette (optional; defaults in config.py are the polite values) ---
# ASX_REQUEST_INTERVAL_SECONDS=3.0
# ASX_USER_AGENT=asx-announcement-research/0.1 (personal research project; github.com/Taylor-Hobbs/asx)
